<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always draws a system splash with the launcher icon. Make it a plain white screen,
         so it flows into the app's own white welcome screen instead of showing the logo twice. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
    </style>
</resources>
